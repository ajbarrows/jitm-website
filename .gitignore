.wrangler/
.netlify/
.dev.vars

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Source material that isn't part of the site:
