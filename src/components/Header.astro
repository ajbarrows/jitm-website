---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import logo from '../../content/images/logo.png';

const nav = [
  { href: '/faculty/', label: 'Faculty' },
  { href: '/scholarships/', label: 'Scholarships' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const current = (href: string) => path.startsWith(url(href));
---
<header class="site-header">
  <div class="header-inner">
    <a href={url('/')} class="brand" aria-label="Jazz in the Mountains, home">
      <Image src={logo} alt="" width={150} densities={[1, 2]} loading="eager" />
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={url(item.href)} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a href={url('/apply/')} class="btn btn-small" aria-current={current('/apply/') ? 'page' : undefined}>Apply</a></li>
      </ul>
    </nav>
  </div>
</header>
