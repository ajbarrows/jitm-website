---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Short photo strip behind the site header only; the page shows its own title below. */
  strip?: boolean;
}
const { eyebrow, title, lede, image, imageAlt = '', strip = false } = Astro.props;
---
<section class:list={['banner', { 'banner-strip': strip }]} aria-label={strip ? title : undefined}>
  {image && <Image src={image} alt={imageAlt} class="banner-img" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />}
  <div class="banner-shade"></div>
  {!strip && (
    <div class="container banner-content">
      {eyebrow && <p class="label label-light">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="banner-lede">{lede}</p>}
      <slot />
    </div>
  )}
</section>
