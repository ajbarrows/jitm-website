---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import photo from '../../content/images/photos/img-9230.jpg';
---
<Base title="Page not found" description="This page doesn't exist.">
  <PageHeader eyebrow="404" title="Wrong note." lede="We couldn't find that page. It may have moved when the site was redesigned." image={photo}>
    <div class="btn-row center"><a href={url('/')} class="btn">Home page</a><a href={url('/apply/')} class="btn btn-light">Apply</a></div>
  </PageHeader>
</Base>
