---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { getData, getPage, fill, md, telHref } from '../lib/content';

const data = await getData();
const { camp, links } = data;
const page = await getPage('contact');
---
<Base title={fill(page.data.title, data)} description={fill(page.data.description, data)} cta={false}>
  <PageHeader eyebrow="Contact" title="Get in touch" image={page.data.banner} imageAlt={page.data.bannerAlt}>
    <div class="banner-lede" set:html={md(page.body, data)} />
  </PageHeader>
  <section class="section">
    <div class="container contact-grid">
      <div>
        <SectionTitle label="Email" level="h3" />
        <p><a href={`mailto:${camp.contact.email}`} class="big-link">{camp.contact.email}</a></p>
      </div>
      <div>
        <SectionTitle label="Phone" level="h3" />
        <p><a href={telHref(camp.contact.phone)} class="big-link">{camp.contact.phone}</a></p>
      </div>
      <div>
        <SectionTitle label="Mail" level="h3" />
        <p class="big-text">{camp.organization.name}{camp.contact.mailingAddress.map((line) => <><br />{line}</>)}</p>
      </div>
    </div>
  </section>
  <section class="split-media">
    {page.data.venuePhoto && <Image src={page.data.venuePhoto} alt={page.data.venuePhotoAlt ?? ''} widths={[700, 1100]} sizes="(min-width: 900px) 50vw, 100vw" />}
    <div class="split-media-body">
      <SectionTitle label="Where camp is held" title={camp.venue} align="left" />
      <p class="big-text">{camp.town}</p>
      <div class="btn-row">
        <a href={links.directions} class="btn btn-dark">Get directions</a>
        <a href={links.venue} class="btn btn-outline">About the hotel</a>
      </div>
    </div>
  </section>
</Base>
