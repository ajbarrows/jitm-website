---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import TestimonialGroup from '../components/TestimonialGroup.astro';
import { getAudition, getData, getPage, getTestimonials, fill, md, mdInline, isSet } from '../lib/content';

const data = await getData();
const { camp, fees, links, deadlines, deadline } = data;
const { data: d } = await getPage('apply');
const quotes = await getTestimonials({ spot: 'apply' });
const audition = await getAudition();
const formatPrice = (n: number) => `$${n.toLocaleString('en-US')}`;
const { single, shared } = fees.labels;
const partner = fees.partner && !fees.partner.draft ? fees.partner : undefined;
const commuter = fees.commuter && !fees.commuter.draft ? fees.commuter : undefined;
---
<Base title={fill(d.title, data)} description={fill(d.description, data)}>
  <PageHeader eyebrow={`${camp.dates} · ${camp.town}`} title={fill(d.title, data)} lede={d.intro && fill(d.intro, data)} image={d.banner} imageAlt={d.bannerAlt} />

  <section class="section">
    <div class="container">
      <SectionTitle label="How to apply" title="Four steps to the bandstand" />
      <ol class="process">
        {d.steps?.map((step, i) => {
          const href = step.button ? fill(step.button.href, data) : '';
          const due = step.deadline ? deadline[step.deadline] : undefined;
          if (step.deadline && !due) throw new Error(`Apply step "${step.title}" refers to unknown deadline "${step.deadline}"`);
          return (
            <li>
              <span class="process-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              {due && <p class="due">Due {due}</p>}
              <div class="prose" set:html={md(step.body, data)} />
              {step.button && isSet(href) && <a href={href} class="text-link">{step.button.label} →</a>}
            </li>
          );
        })}
      </ol>
      <TestimonialGroup quotes={quotes} />
    </div>
  </section>

  <section class="section section-warm">
    <div class="container split-even">
      <div>
        <SectionTitle label="Who can apply" align="left" />
        <ul class="checklist">
          {camp.eligibility.map((e) => <li>{e}</li>)}
        </ul>
        {d.creditNote && (
          <p class="download-note">
            <a href={url('/earn-college-credit/')} class="text-link">{d.creditNote.label} →</a>
            <span>{fill(d.creditNote.text, data)}</span>
          </p>
        )}
      </div>
      <div>
        <SectionTitle label="Key dates" align="left" />
        <dl class="dates">
          {deadlines.map((x) => <div><dt>{x.date}</dt><dd>{x.item}</dd></div>)}
        </dl>
        {links.atAGlance && (
          <p class="download-note">
            <a href={url(links.atAGlance)} class="text-link">Download the {camp.year} camp at a glance (PDF) →</a>
            <span>Dates, costs, a typical day and the faculty on two printable pages.</span>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle label="Camp fees" title="One price covers the week" />
      <div class="table-wrap">
        <table>
          <caption class="visually-hidden">Camp fees by room type and occupancy</caption>
          <thead>
            <tr>
              <th scope="col">Room type</th>
              <th scope="col">{single.label}<span class="th-note">{single.note}</span></th>
              <th scope="col">{shared.label}<span class="th-note">{shared.note}</span></th>
            </tr>
          </thead>
          <tbody>
            {fees.rooms.map((r) => (
              <tr>
                <th scope="row">{r.room}</th>
                <td data-label={`${single.label} (${single.note})`}>{formatPrice(r.single)}</td>
                <td data-label={`${shared.label} (${shared.note})`}>{formatPrice(r.shared)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {fees.roomsNote && <p class="table-note">{fees.roomsNote}</p>}
      {d.scholarshipNote && <p class="scholarship-note" set:html={mdInline(d.scholarshipNote, data)} />}
      {(partner || commuter) && (
        <div class:list={['fee-extras', { 'fee-extras-two': partner && commuter }]}>
          {partner && (
            <div class="fee-extra fee-extra-partner">
              <p class="label">Bringing a partner who isn't a camper?</p>
              <p class="fee-extra-price">+{formatPrice(partner.price)}</p>
              <p>Add this to the single-room price for any room type.</p>
              {partner.note && <p>{partner.note}</p>}
            </div>
          )}
          {commuter && (
            <div class="fee-extra">
              <p class="label">{commuter.label}</p>
              <p class="fee-extra-price">{formatPrice(commuter.price)}</p>
              {commuter.note && <p>{commuter.note}</p>}
            </div>
          )}
        </div>
      )}
      <div class="included">
        <div><p class="label">Included</p><p>{fees.included}</p></div>
        <div><p class="label">Not included</p><p>{fees.notIncluded}</p></div>
      </div>
    </div>
  </section>

  <section class="section section-warm" id="audition">
    <div class="container narrow">
      <SectionTitle label="Video submission" title="Recording your video" />
      <p class="center">Download the sheet music and play-along tracks, then follow the instructions for your instrument.</p>
      <div class="btn-row center">
        {isSet(links.auditionMusic) && <a href={links.auditionMusic} class="btn btn-outline">Sheet music and recordings</a>}
        {isSet(links.forms.videoUpload) && <a href={links.forms.videoUpload} class="btn btn-dark">Upload your video</a>}
      </div>
      {audition && (
        <>
          {audition.general.map((g) => (
            <div class="audition-general">
              <h3>{g.title}</h3>
              <div class="prose" set:html={md(g.body, data)} />
            </div>
          ))}
          <h3 class="audition-pick">Instructions for your instrument</h3>
          <div class="accordion">
            {[audition.horns, audition.rhythm, audition.drums].map((a) => (
              <details>
                <summary>{a.title}</summary>
                <div class="prose" set:html={md(a.body, data)} />
              </details>
            ))}
          </div>
        </>
      )}
      {audition.questions && (
        <div class="audition-general audition-questions">
          <h3>{audition.questions.title}</h3>
          <div class="prose" set:html={md(audition.questions.body, data)} />
        </div>
      )}
    </div>
  </section>
</Base>
